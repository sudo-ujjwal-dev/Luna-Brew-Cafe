# Admin login (required to access /admin-dashboard)
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
AUTH_SECRET=replace-with-at-least-32-random-characters

# Optional canonical website URL for sitemap and production SEO
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional OpenStreetMap embed URL for the approximate demo location
NEXT_PUBLIC_MAP_EMBED_URL=https://www.openstreetmap.org/export/embed.html?bbox=83.96%2C28.19%2C84.01%2C28.23&layer=mapnik&marker=28.2096%2C83.9856
