generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  REJECTED
  COMPLETED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERY_ISSUE
  COMPLETED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContactStatus {
  UNREAD
  READ
  RESOLVED
}

model User {
  id           String           @id @default(cuid()) @db.VarChar(30)
  email        String           @unique @db.VarChar(254)
  passwordHash String           @db.VarChar(255)
  role         UserRole         @default(CUSTOMER)
  name         String?          @db.VarChar(120)
  phone        String?          @db.VarChar(30)
  orders       Order[]
  reservations Reservation[]
  messages     ContactMessage[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([role])
}

model Category {
  id        String     @id @default(cuid()) @db.VarChar(30)
  name      String     @unique @db.VarChar(80)
  slug      String     @unique @db.VarChar(100)
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([active, sortOrder])
}

model MenuItem {
  id              String      @id @default(cuid()) @db.VarChar(30)
  name            String      @db.VarChar(120)
  slug            String      @unique @db.VarChar(140)
  description     String      @db.Text
  price           Decimal     @db.Decimal(10, 2)
  image           String?     @db.VarChar(2048)
  imageAlt        String?     @db.VarChar(255)
  categoryId      String      @db.VarChar(30)
  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  available       Boolean     @default(true)
  featured        Boolean     @default(false)
  vegetarian      Boolean     @default(false)
  vegan           Boolean     @default(false)
  spicy           Boolean     @default(false)
  allergens       Json?
  preparationTime Int?
  orderItems      OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([categoryId, available])
  @@index([featured, available])
  @@index([name])
}

model Reservation {
  id             String            @id @default(cuid()) @db.VarChar(30)
  customerName   String            @db.VarChar(120)
  phone          String            @db.VarChar(30)
  email          String            @db.VarChar(254)
  date           DateTime          @db.Date
  time           String            @db.VarChar(10)
  guestCount     Int
  specialRequest String?           @db.Text
  status         ReservationStatus @default(PENDING)
  userId         String?           @db.VarChar(30)
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([date, time])
  @@index([status, date])
  @@index([userId, date])
  @@index([createdAt])
}

model Order {
  id              String      @id @default(cuid()) @db.VarChar(30)
  orderNumber     String      @unique @db.VarChar(32)
  customerName    String      @db.VarChar(120)
  phone           String      @db.VarChar(30)
  email           String?     @db.VarChar(254)
  type            OrderType
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @db.Decimal(10, 2)
  deliveryFee     Decimal     @default(0) @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  deliveryAddress String?     @db.Text
  notes           String?     @db.Text
  paymentMethod   String      @default("PAY_AT_CAFE") @db.VarChar(30)
  deliveryConfirmedAt DateTime?
  deliveryIssueReportedAt DateTime?
  deliveryIssueResolvedAt DateTime?
  userId          String?     @db.VarChar(30)
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  reviews         Review[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([phone, createdAt])
  @@index([userId, createdAt])
}

model OrderItem {
  id         String    @id @default(cuid()) @db.VarChar(30)
  orderId    String    @db.VarChar(30)
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?   @db.VarChar(30)
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  itemName   String    @db.VarChar(120)
  unitPrice  Decimal   @db.Decimal(10, 2)
  quantity   Int
  lineTotal  Decimal   @db.Decimal(10, 2)
  createdAt  DateTime  @default(now())

  @@index([orderId])
  @@index([menuItemId])
}

model Review {
  id           String       @id @default(cuid()) @db.VarChar(30)
  customerName String       @db.VarChar(120)
  rating       Int
  comment      String       @db.Text
  status       ReviewStatus @default(PENDING)
  orderId      String?      @unique @db.VarChar(30)
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, createdAt])
}

model ContactMessage {
  id        String        @id @default(cuid()) @db.VarChar(30)
  name      String        @db.VarChar(120)
  email     String        @db.VarChar(254)
  phone     String?       @db.VarChar(30)
  subject   String        @db.VarChar(160)
  message   String        @db.Text
  status    ContactStatus @default(UNREAD)
  userId    String?       @db.VarChar(30)
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model GalleryImage {
  id        String   @id @default(cuid()) @db.VarChar(30)
  title     String   @db.VarChar(120)
  imageUrl  String   @db.VarChar(2048)
  altText   String   @db.VarChar(255)
  category  String   @db.VarChar(60)
  visible   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, sortOrder])
}

model BusinessSettings {
  id            String   @id @default("default") @db.VarChar(30)
  businessName  String   @default("Luna Brew Café") @db.VarChar(120)
  locationLabel String   @default("Lakeside, Pokhara, Nepal") @db.VarChar(255)
  address       String?  @db.VarChar(255)
  phone         String?  @db.VarChar(30)
  email         String?  @db.VarChar(254)
  openingHours  Json?
  mapEmbedUrl   String?  @db.VarChar(2048)
  deliveryFee   Decimal  @default(0) @db.Decimal(10, 2)
  updatedAt     DateTime @updatedAt
}
